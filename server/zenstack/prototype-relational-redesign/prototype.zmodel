datasource db {
  provider = 'postgresql'
  url      = env('DATABASE_URL')
}

plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

// ── Identity / Membership / Sessions ─────────────────────────────────────────

model User {
  id          String   @id @default(uuid(4))
  displayName String?
  status      String   @default('active')
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  passwordCredential UserPasswordCredential?
  memberships        Membership[]
  actorContexts      ActorContext[]
  sessions           AuthSession[]
  roleAssignments RoleAssignment[]
}
model UserPasswordCredential {

  userId       String   @id @unique
  user         User     @relation(fields: [userId], references: [id])
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
}

model Tenant {
  id   String @id @default(uuid(4))
  name String?

  memberships      Membership[]
  actorContexts    ActorContext[]
  authScopes       AuthScope[]
  capabilityGrants DerivedCapabilityGrant[]
  documents        DocumentBase[]
  tenantApps       TenantApp[]
  roles            Role[]
  roleAssignments  RoleAssignment[]
}

model Membership {
  id        String   @id @default(uuid(4))
  tenantId   String  
  userId    String  
  status    String   @default('active')
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  actorContexts ActorContext[]
  sessions      AuthSession[]

  @@unique([userId, tenantId])
}

model ActorContext {
  id           String @id @default(uuid(4))
  userId       String
  tenantId     String
  membershipId String

  user             User                   @relation(fields: [userId], references: [id])
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  membership       Membership             @relation(fields: [membershipId], references: [id])
  capabilityGrants DerivedCapabilityGrant[]

  @@auth
  @@unique([userId, tenantId, membershipId])
}

model AuthSession {
  tokenHash         String   @id
  userId            String  
  tenantId          String? 
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  lastRenewedAt     DateTime @db.Timestamptz(6)
  expiresAt         DateTime @db.Timestamptz(6)
  absoluteExpiresAt DateTime @db.Timestamptz(6)

  user     User       @relation(fields: [userId], references: [id])
  membership Membership? @relation(fields: [tenantId, userId], references: [tenantId, userId])
}

// ── App / Collection Catalog ──────────────────────────────────────────────────

model App {
  id        String   @id @default(uuid(4))
  key       String   @unique
  name      String?
  config    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  collections Collection[]
  tenantApps  TenantApp[]
  permissions Permission[]
  roles       Role[]
}

model TenantApp {
  tenantId  String   
  appId     String   
  config    Json?
  enabledAt DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  app    App    @relation(fields: [appId], references: [id])

  @@id([tenantId, appId])
}

model Collection {
  id                   String   @id @default(uuid(4))
  appId                String  
  collectionKey        String
  qualifiedCollectionKey String @unique
  definitionKey        String
  name                 String?
  schemaVersion        Int
  config               Json?
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  app  App  @relation(fields: [appId], references: [id])

  @@unique([appId, collectionKey])
}

// ── Scope Tree ────────────────────────────────────────────────────────────────

model AuthScope {
  id        String   @id @default(uuid(4))
  tenantId  String  
  parentId  String?
  path  String[]
  type      String
  key       String?
  name      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant            Tenant                    @relation(fields: [tenantId], references: [id])
  parent            AuthScope?                @relation('ScopeParent', fields: [parentId], references: [id])
  children          AuthScope[]               @relation('ScopeParent')
  ancestors           AuthScopeClosure[]        @relation('Ancestor')
  descendants         AuthScopeClosure[]        @relation('Descendant')
  grantsAsGrantScope  DerivedCapabilityGrant[] @relation('GrantScope')
  documents           DocumentBase[]
  roleAssignments     RoleAssignment[]
  // Scope-tree RBAC: path = [this.id, ...ancestor_ids] (includes self).
  // Access controlled via DocumentBase policies using this.authScope.path.
  // AuthScope is read through the protected client's DocumentBase delegate.
}
model AuthScopeClosure {
  ancestorId   String
  descendantId String
  depth        Int

  ancestor   AuthScope @relation('Ancestor', fields: [ancestorId], references: [id])
  descendant AuthScope @relation('Descendant', fields: [descendantId], references: [id])

  @@id([ancestorId, descendantId])
}

// ── RBAC Definitions ──────────────────────────────────────────────────────────

model Permission {
  key           String @id
  appId         String?
  collectionId  String?
  capabilityId  String
  source        String
  description   String?
  resourceScope String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  app         App?            @relation(fields: [appId], references: [id])
  rolePermissions RolePermission[]
}

model Role {
  id        String   @id @default(uuid(4))
  tenantId  String  
  appId     String  
  key       String
  name      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  app             App              @relation(fields: [appId], references: [id])
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@unique([tenantId, key])
}

model RolePermission {
  tenantId      String
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([tenantId, roleId, permissionKey])
}

model RoleAssignment {
  id        String   @id @default(uuid(4))
  tenantId  String  
  userId    String  
  roleId    String  
  scopeId   String  
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  user   User      @relation(fields: [userId], references: [id])
  role   Role      @relation(fields: [roleId], references: [id])
  scope  AuthScope @relation(fields: [scopeId], references: [id])

  @@unique([tenantId, userId, roleId, scopeId])
}

// ── Effective Access Surface ──────────────────────────────────────────────────

model DerivedCapabilityGrant {
  id             String @id @default(uuid(4))
  actorContextId String
  tenantId       String
  capabilityKey  String
  grantScopeId   String

  actorContext ActorContext @relation(fields: [actorContextId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  grantScope   AuthScope    @relation('GrantScope', fields: [grantScopeId], references: [id])

  @@index([actorContextId, capabilityKey])
  @@index([grantScopeId])
}

// ── Managed Documents ─────────────────────────────────────────────────────────

model DocumentBase {
  documentId           String    @id @default(uuid(4))
  tenantId             String   
  authScopeId          String   
  qualifiedCollectionKey String
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime? @db.Timestamptz(6)
  remoteSource         String?
  remoteId             String?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  authScope AuthScope @relation(fields: [authScopeId], references: [id])

  @@delegate(qualifiedCollectionKey)

  // ── Baseline CRUD policy ──
  // FQN capabilityKey + ancestor scope match via authScope.path.
  // Fixed: #2733 (this.relation.field resolution + array subquery handling)
  @@allow('create',
    auth() != null &&
    auth().tenantId == tenantId &&
    auth().capabilityGrants?[g,
      g.tenantId == this.tenantId &&
      endsWith(g.capabilityKey, ':create') &&
      (g.grantScopeId == this.authScopeId || g.grantScopeId in this.authScope.path)
    ]
  )
  @@allow('read',
    auth() != null &&
    auth().tenantId == tenantId &&
    deletedAt == null &&
    auth().capabilityGrants?[g,
      g.tenantId == this.tenantId &&
      endsWith(g.capabilityKey, ':read') &&
      (g.grantScopeId == this.authScopeId || g.grantScopeId in this.authScope.path)
    ]
  )
  @@allow('update',
    auth() != null &&
    auth().tenantId == tenantId &&
    auth().capabilityGrants?[g,
      g.tenantId == this.tenantId &&
      endsWith(g.capabilityKey, ':update') &&
      (g.grantScopeId == this.authScopeId || g.grantScopeId in this.authScope.path)
    ]
  )
  @@allow('delete',
    auth() != null &&
    auth().tenantId == tenantId &&
    auth().capabilityGrants?[g,
      g.tenantId == this.tenantId &&
      endsWith(g.capabilityKey, ':delete') &&
      (g.grantScopeId == this.authScopeId || g.grantScopeId in this.authScope.path)
    ]
  )
}

model ProjectDocument extends DocumentBase {
  title  String
  status String @default('draft')

  @@delegateMap('default:projects')
  revisions ProjectRevision[]
}

model LockedDocument extends DocumentBase {
  title  String
  locked Boolean @default(true)

  @@delegateMap('default:locked-documents')
  @@deny('update', locked == true)
}

// ── Unmanaged Support Tables ──────────────────────────────────────────────────

model ProjectRevision {
  id         String   @id @default(uuid(4))
  documentId String  
  body       String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  document ProjectDocument @relation(fields: [documentId], references: [documentId])
}
