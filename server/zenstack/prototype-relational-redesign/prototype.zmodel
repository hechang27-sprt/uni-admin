datasource db {
  provider = 'postgresql'
  url      = env('DATABASE_URL')
}

plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

// ── Identity / Membership / Sessions ─────────────────────────────────────────

model User {
  userId             String                  @id @default(uuid(4))
  displayName        String?
  status             String                  @default('active')
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)

  passwordCredential UserPasswordCredential?
  memberships        Membership[]
  actorContexts      ActorContext[]
  sessions           AuthSession[]
  roleAssignments    RoleAssignment[]
}
model UserPasswordCredential {

  userId       String   @id @unique
  user         User     @relation(fields: [userId], references: [userId])
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
}

model Tenant {
  tenantId        String           @id @default(uuid(4))
  name            String?

  memberships     Membership[]
  actorContexts   ActorContext[]
  authScopes      AuthScope[]
  documents       DocumentBase[]
  tenantApps      TenantApp[]
  roles           Role[]
  roleAssignments RoleAssignment[]
}

model Membership {
  membershipId  String         @id @default(uuid(4))
  tenantId      String
  userId        String
  status        String         @default('active')
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [tenantId])
  user          User           @relation(fields: [userId], references: [userId])
  actorContexts ActorContext[]
  sessions      AuthSession[]

  @@unique([userId, tenantId])
}

model ActorContext {
  ctxId        String     @id @default(uuid(4))
  userId       String
  tenantId     String
  membershipId String

  user         User       @relation(fields: [userId], references: [userId])
  tenant       Tenant     @relation(fields: [tenantId], references: [tenantId])
  membership   Membership @relation(fields: [membershipId], references: [membershipId])

  @@auth
  @@unique([userId, tenantId, membershipId])
}

model AuthSession {
  tokenHash         String      @id
  userId            String
  tenantId          String?
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  lastRenewedAt     DateTime    @db.Timestamptz(6)
  expiresAt         DateTime    @db.Timestamptz(6)
  absoluteExpiresAt DateTime    @db.Timestamptz(6)

  user              User        @relation(fields: [userId], references: [userId])
  membership        Membership? @relation(fields: [tenantId, userId], references: [tenantId, userId])
}

// ── App / Collection Catalog ──────────────────────────────────────────────────

model App {
  appKey      String         @id
  name        String?
  config      Json?
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  collections Collection[]
  tenantApps  TenantApp[]
  permissions Permission[]
  roles       Role[]
  documents   DocumentBase[]
}

model TenantApp {
  tenantId  String
  appKey    String
  config    Json?
  enabledAt DateTime @default(now()) @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId])
  app       App      @relation(fields: [appKey], references: [appKey])

  @@id([tenantId, appKey])
}

model Collection {
  appKey                 String
  collectionKey          String
  qualifiedCollectionKey String         @unique
  definitionKey          String
  name                   String?
  schemaVersion          Int
  config                 Json?
  createdAt              DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(6)

  app                    App            @relation(fields: [appKey], references: [appKey])
  permissions            Permission[]
  documents              DocumentBase[]

  @@id([appKey, collectionKey])
}

// ── Scope Tree ────────────────────────────────────────────────────────────────

model AuthScope {
  scopeId         String             @id @default(uuid(4))
  tenantId        String
  parentId        String?
  path            String[]
  type            String
  scopeKey        String?
  name            String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  tenant          Tenant             @relation(fields: [tenantId], references: [tenantId])
  parent          AuthScope?         @relation('ScopeParent', fields: [parentId], references: [scopeId])
  children        AuthScope[]        @relation('ScopeParent')
  ancestors       AuthScopeClosure[] @relation('Descendant')
  descendants     AuthScopeClosure[] @relation('Ancestor')
  documents       DocumentBase[]
  roleAssignments RoleAssignment[]
  // Scope-tree RBAC: path = [this.id, ...ancestor_ids] (includes self).
  // AuthScope is read through the protected client's DocumentBase delegate.
}
model AuthScopeClosure {
  ancestorId   String
  descendantId String
  depth        Int

  ancestor     AuthScope @relation('Ancestor', fields: [ancestorId], references: [scopeId])
  descendant   AuthScope @relation('Descendant', fields: [descendantId], references: [scopeId])

  @@id([ancestorId, descendantId])
}

// ── RBAC Definitions ──────────────────────────────────────────────────────────

model Permission {
  qualifiedKey    String           @id
  appKey          String?
  collectionKey   String?
  actionKey       String
  source          String
  description     String?
  resourceScope   String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  app             App?             @relation(fields: [appKey], references: [appKey])
  collection      Collection?      @relation(fields: [appKey, collectionKey], references: [appKey, collectionKey])
  rolePermissions RolePermission[]
}

model Role {
  roleId          String           @id @default(uuid(4))
  tenantId        String
  appKey          String
  roleKey         String
  name            String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [tenantId])
  app             App              @relation(fields: [appKey], references: [appKey])
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@unique([tenantId, roleKey])
}

model RolePermission {
  tenantId      String
  roleId        String
  permissionKey String

  role          Role       @relation(fields: [roleId], references: [roleId])
  permission    Permission @relation(fields: [permissionKey], references: [qualifiedKey])

  @@id([tenantId, roleId, permissionKey])
}

model RoleAssignment {
  assignmentId String    @id @default(uuid(4))
  tenantId     String
  userId       String
  roleId       String
  scopeId      String
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  tenant       Tenant    @relation(fields: [tenantId], references: [tenantId])
  user         User      @relation(fields: [userId], references: [userId])
  role         Role      @relation(fields: [roleId], references: [roleId])
  scope        AuthScope @relation(fields: [scopeId], references: [scopeId])

  @@unique([tenantId, userId, roleId, scopeId])
}


// ── Managed Documents ─────────────────────────────────────────────────────────

model DocumentBase {
  documentId             String     @id @default(uuid(4))
  tenantId               String
  authScopeId            String
  qualifiedCollectionKey String
  appKey                 String
  collectionKey          String
  version                Int        @default(1)
  createdAt              DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?  @db.Timestamptz(6)
  remoteSource           String?
  remoteId               String?

  tenant                 Tenant     @relation(fields: [tenantId], references: [tenantId])
  authScope              AuthScope  @relation(fields: [authScopeId], references: [scopeId])
  app                    App        @relation(fields: [appKey], references: [appKey])
  collection             Collection @relation(fields: [appKey, collectionKey], references: [appKey, collectionKey])

  @@delegate(qualifiedCollectionKey)


  // ── Baseline CRUD policy ──
  // Nested role/permission traversal + asymmetric bottom-scope semantics.
  // Fixed: #2733 (this.relation.field resolution + array subquery handling)
  @@allow('create',
    auth() != null &&
    auth().tenantId == tenantId &&
    auth().user.roleAssignments?[rs,
      rs.tenantId == this.tenantId &&
      rs.role.rolePermissions?[rp, rp.permission.collection == this.collection && rp.permission.actionKey == 'create'] &&
      (
        this.authScope.scopeKey == '__bottom' ||
        rs.scope == this.authScope ||
        this.authScope.ancestors?[ancestor == rs.scope]
      )
    ]
  )
  @@allow('read',
    auth() != null &&
    auth().tenantId == tenantId &&
    deletedAt == null &&
    auth().user.roleAssignments?[rs,
      rs.tenantId == this.tenantId &&
      rs.role.rolePermissions?[rp, rp.permission.collection == this.collection && rp.permission.actionKey == 'read'] &&
      (
        this.authScope.scopeKey == '__bottom' ||
        rs.scope == this.authScope ||
        this.authScope.ancestors?[ancestor == rs.scope]
      )
    ]
  )
  @@allow('update',
    auth() != null &&
    auth().tenantId == tenantId &&
    auth().user.roleAssignments?[rs,
      rs.tenantId == this.tenantId &&
      rs.role.rolePermissions?[rp, rp.permission.collection == this.collection && rp.permission.actionKey == 'update'] &&
      (
        this.authScope.scopeKey == '__bottom' ||
        rs.scope == this.authScope ||
        this.authScope.ancestors?[ancestor == rs.scope]
      )
    ]
  )
  @@allow('delete',
    auth() != null &&
    auth().tenantId == tenantId &&
    auth().user.roleAssignments?[rs,
      rs.tenantId == this.tenantId &&
      rs.role.rolePermissions?[rp, rp.permission.collection == this.collection && rp.permission.actionKey == 'delete'] &&
      (
        this.authScope.scopeKey == '__bottom' ||
        rs.scope == this.authScope ||
        this.authScope.ancestors?[ancestor == rs.scope]
      )
    ]
  )
}

model ProjectDocument extends DocumentBase {
  title     String
  status    String            @default('draft')

  @@delegateMap('default:projects')
  revisions ProjectRevision[]
}

model PartnerProjectDocument extends DocumentBase {
  title  String
  status String @default('draft')

  @@delegateMap('partner:projects')
}

model LockedDocument extends DocumentBase {
  title  String
  locked Boolean @default(true)

  @@delegateMap('default:locked-documents')
  @@deny('update', locked == true)
}

// ── Unmanaged Support Tables ──────────────────────────────────────────────────

model ProjectRevision {
  id         String          @id @default(uuid(4))
  documentId String
  body       String
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)

  document   ProjectDocument @relation(fields: [documentId], references: [documentId])
}
